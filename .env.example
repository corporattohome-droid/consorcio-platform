# ============================================================
# CONSÓRCIO PLATFORM — VARIÁVEIS DE AMBIENTE
# Copie para .env e preencha os valores reais antes de rodar
# NUNCA commite o arquivo .env com dados reais
# ============================================================

# --- PostgreSQL ---
DATABASE_URL="postgresql://consorcio_user:consorcio_pass@localhost:5432/consorcio_db?schema=public"
POSTGRES_USER=consorcio_user
POSTGRES_PASSWORD=consorcio_pass
POSTGRES_DB=consorcio_db

# --- Redis ---
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# --- API (NestJS) ---
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_64_CHARS_XXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET_XXXXXXXXXXXXXXXXXXXXXXXX
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=consorcio
KEYCLOAK_CLIENT_ID=consorcio-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASS

# --- Next.js Admin ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_MIN_32_CHARS_XXXXXXXXX

# --- Next.js Client Portal ---
NEXT_PUBLIC_CLIENT_API_URL=http://localhost:3001
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3002
CLIENT_NEXTAUTH_URL=http://localhost:3002
CLIENT_NEXTAUTH_SECRET=CHANGE_ME_CLIENT_NEXTAUTH_SECRET_XXXXXXXXXXXXXXXXX

# --- Armazenamento (S3 / LocalStack em dev) ---
STORAGE_DRIVER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_OR_USE_LOCALSTACK
AWS_SECRET_ACCESS_KEY=CHANGE_ME_OR_USE_LOCALSTACK
AWS_S3_BUCKET=consorcio-documents
AWS_ENDPOINT=http://localhost:4566  # LocalStack em dev

# --- E-mail (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Consórcio Platform <noreply@consorcio.local>"

# --- Feature Flags ---
ENABLE_MFA=false
ENABLE_DIGITAL_SIGNATURE=false
ENABLE_PAYMENT_GATEWAY=false

# --- Observabilidade ---
LOG_LEVEL=debug
SENTRY_DSN=
